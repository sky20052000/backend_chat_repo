{
  "name": "relationship-and-coach-platform-chat-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Modular-monolith chat backend using PostgreSQL, Firestore, and Socket.IO",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.cjs",
    "start": "node dist/server.js",
    "db:migrate": "node dist/infra/database/migrate.js",
    "db:backfill-messages": "node dist/infra/database/backfill-firestore-messages.js",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.0.0",
    "http-errors": "^2.0.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
